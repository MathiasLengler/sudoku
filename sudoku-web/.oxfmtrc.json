{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["pnpm-lock.yaml"],
    "overrides": [
        {
            "files": ["*.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ],
    "printWidth": 120,
    // https://oxc.rs/docs/guide/usage/formatter/sorting.html#example-configuration
    "sortImports": {
        "groups": [
            "type-import",
            ["value-builtin", "value-external"],
            "type-internal",
            "value-internal",
            ["type-parent", "type-sibling", "type-index"],
            ["value-parent", "value-sibling", "value-index"],
            "unknown"
        ]
    },
    "sortPackageJson": {
        "sortScripts": true
    },
    "tabWidth": 4
}
